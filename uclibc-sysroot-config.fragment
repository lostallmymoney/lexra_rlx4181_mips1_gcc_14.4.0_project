# uclibc-sysroot-config.fragment - the Kconfig fragment build-toolchain.sh
# applies over the in-tree uClibc-ng defconfig when it builds the sysroot
# uClibc from the in-tree source (VANILLArecontruct/rootfs/lib/uclibc-ng).
# build-toolchain.sh then applies the three shipped inputs on top
# (the hub's 2.6.30 kernel headers, the generic C string routines,
# and the linuxthreads thread model in place of the NPTL lines
# below) - the fragment alone is the pre-unification sysroot
# recipe, not the final config.
#
# Every line mirrors the Bootlin base toolchain's effective uClibc config,
# read off the base sysroot's bits/uClibc_config.h, so the project-built
# libc declares and provides exactly what the base one did - with two
# deliberate deviations:
#
#   UCLIBC_USE_TIME64 off. The hub's vendor uClibc 0.9.30.3 has a 32-bit
#   time_t; Bootlin's config turns the 64-bit-time headers on, and every
#   program compiled against them then disagrees with the runtime libc on
#   the layout of time_t, struct timeval/timespec, struct utimbuf and the
#   timestamp block of struct stat (measured: busybox ls -l printing 1989
#   for a 2023 file, ntpclient's settimeofday answered EINVAL, DHCP lease
#   expiry garbage). Off, the headers match the device again.
#
#   UCLIBC_HAS_FPU off. The Lexra core has no FPU: with FPU on, uClibc's
#   MIPS setjmp/longjmp assembly uses FPU registers and cannot even
#   assemble with this mips1/soft-float compiler. Same call as the
#   atexit harvest in build-toolchain.sh. (Config fallout is exactly
#   __UCLIBC_HAS_FPU__ -> __UCLIBC_HAS_SOFT_FLOAT__.)
#
# The locale data generation in this build reads the HOST's generated
# locales: en_US and en_US.UTF-8 must exist (localedef) or the build
# stops and says so - with no host en_US, uClibc silently generates
# empty locale tables and the build dies later in gen_ldc.
# DOSTRIP is not set
# LDSO_CACHE_SUPPORT is not set
# UCLIBC_HAS_FPU is not set
# UCLIBC_STATIC_LDCONFIG is not set
# UCLIBC_USE_TIME64 is not set
ASSUME_DEVPTS=y
DEVEL_PREFIX="/usr"
DO_C99_MATH=y
DO_XSI_MATH=y
HARDWIRED_ABSPATH=y
LDSO_LDD_SUPPORT=y
LDSO_LD_LIBRARY_PATH=y
LDSO_PRELOAD_ENV_SUPPORT=y
LDSO_RUNPATH=y
LDSO_RUNPATH_OF_EXECUTABLE=y
LDSO_SAFE_RUNPATH=y
LDSO_SEARCH_INTERP_PATH=y
MALLOC_STANDARD=y
MULTILIB_DIR="lib"
PTHREADS_DEBUG_SUPPORT=y
PTHREADS_STACK_DEFAULT_SIZE=2097152
RUNTIME_PREFIX="/"
UCLIBC_BSD_SPECIFIC=y
UCLIBC_BUILD_MINIMAL_LOCALE=y
UCLIBC_BUILD_MINIMAL_LOCALES="en_US"
UCLIBC_BUILD_NOEXECSTACK=y
UCLIBC_BUILD_NOW=y
UCLIBC_BUILD_RELRO=y
UCLIBC_CTOR_DTOR=y
UCLIBC_DNSRAND_MODE_PRNGPLUS=y
UCLIBC_DYNAMIC_ATEXIT=y
UCLIBC_FALLBACK_TO_ETC_LOCALTIME=y
UCLIBC_GRP_BUFFER_SIZE=256
UCLIBC_HAS_ADVANCED_REALTIME=y
UCLIBC_HAS_BSD_ERR=y
UCLIBC_HAS_COMPAT_RES_STATE=y
UCLIBC_HAS_CONTEXT_FUNCS=y
UCLIBC_HAS_CRYPT=y
UCLIBC_HAS_CRYPT_IMPL=y
UCLIBC_HAS_CTYPE_CHECKED=y
UCLIBC_HAS_CTYPE_SIGNED=y
UCLIBC_HAS_CTYPE_TABLES=y
UCLIBC_HAS_EPOLL=y
UCLIBC_HAS_ERRNO_MESSAGES=y
UCLIBC_HAS_FLOATS=y
UCLIBC_HAS_FNMATCH=y
UCLIBC_HAS_FOPEN_EXCLUSIVE_MODE=y
UCLIBC_HAS_FTW=y
UCLIBC_HAS_GETOPT_LONG=y
UCLIBC_HAS_GETPT=y
UCLIBC_HAS_GLIBC_CUSTOM_PRINTF=y
UCLIBC_HAS_GLIBC_CUSTOM_STREAMS=y
UCLIBC_HAS_GLOB=y
UCLIBC_HAS_GNU_ERROR=y
UCLIBC_HAS_GNU_GETOPT=y
UCLIBC_HAS_GNU_GETSUBOPT=y
UCLIBC_HAS_GNU_GLOB=y
UCLIBC_HAS_HEXADECIMAL_FLOATS=y
UCLIBC_HAS_IPV4=y
UCLIBC_HAS_IPV6=y
UCLIBC_HAS_LFS=y
UCLIBC_HAS_LIBICONV=y
UCLIBC_HAS_LIBINTL=y
UCLIBC_HAS_LIBUTIL=y
UCLIBC_HAS_LOCALE=y
UCLIBC_HAS_LONG_DOUBLE_MATH=y
UCLIBC_HAS_NETWORK_SUPPORT=y
UCLIBC_HAS_NFTW=y
UCLIBC_HAS_OBSOLETE_BSD_SIGNAL=y
UCLIBC_HAS_PRINTF_M_SPEC=y
UCLIBC_HAS_PROFILING=y
UCLIBC_HAS_PROGRAM_INVOCATION_NAME=y
UCLIBC_HAS_PTY=y
UCLIBC_HAS_REALTIME=y
UCLIBC_HAS_REGEX=y
UCLIBC_HAS_RESOLVER_SUPPORT=y
UCLIBC_HAS_SHA256_CRYPT_IMPL=y
UCLIBC_HAS_SHA512_CRYPT_IMPL=y
UCLIBC_HAS_SHADOW=y
UCLIBC_HAS_SIGNUM_MESSAGES=y
UCLIBC_HAS_SOCKET=y
UCLIBC_HAS_STDIO_AUTO_RW_TRANSITION=y
UCLIBC_HAS_STDIO_BUFSIZ_4096=y
UCLIBC_HAS_STDIO_BUILTIN_BUFFER_NONE=y
UCLIBC_HAS_STDIO_FUTEXES=y
UCLIBC_HAS_STDIO_GETC_MACRO=y
UCLIBC_HAS_STDIO_PUTC_MACRO=y
UCLIBC_HAS_STRING_ARCH_OPT=y
UCLIBC_HAS_STRING_GENERIC_OPT=y
UCLIBC_HAS_SYSLOG=y
UCLIBC_HAS_THREADS=y
UCLIBC_HAS_THREADS_NATIVE=y
UCLIBC_HAS_TLS=y
UCLIBC_HAS_TM_EXTENSIONS=y
UCLIBC_HAS_TZ_CACHING=y
UCLIBC_HAS_TZ_FILE=y
UCLIBC_HAS_TZ_FILE_READ_MANY=y
UCLIBC_HAS_UTMP=y
UCLIBC_HAS_UTMPX=y
UCLIBC_HAS_WCHAR=y
UCLIBC_HAS_WORDEXP=y
UCLIBC_HAS_XATTR=y
UCLIBC_HAS_XLOCALE=y
UCLIBC_HAS___PROGNAME=y
UCLIBC_LINUX_SPECIFIC=y
UCLIBC_PRINTF_SCANF_POSITIONAL_ARGS=9
UCLIBC_PWD_BUFFER_SIZE=256
UCLIBC_SUPPORT_AI_ADDRCONFIG=y
UCLIBC_SUSV2_LEGACY=y
UCLIBC_SUSV3_LEGACY=y
UCLIBC_SUSV4_LEGACY=y
UCLIBC_TZ_FILE_PATH="/etc/TZ"
UCLIBC_USE_MIPS_PREFETCH=y
UCLIBC_USE_NETLINK=y
UNIX98PTY_ONLY=y
