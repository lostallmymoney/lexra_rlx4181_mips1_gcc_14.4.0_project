# lexra_gcc_14.4_project - what git never carries.
#
# The repo holds source + scripts + patches only. Everything
# below is a build product or a download: the build scripts
# regenerate or re-fetch all of it (0.0_BUILD_TOOLCHAIN.sh /
# build-toolchain.sh).

# The built compiler itself - build-toolchain.sh's install.
/toolchain/

# The GCC source at the pinned version: downloaded pristine,
# patched in place by the build. The patch files in patches/
# are the source form of our changes.
/gcc-*-src/
*.tar.xz
*.tar.bz2
*.tar.gz

# Build trees.
/build-gcc-mips1/
/build-gcc-mips1-c-only*/
/build-gcc-uclibc-sysroot/

# The promoted shipped-runtime copy - regenerated by
# build-shipped-runtime.sh from the sysroot.
/runtime-ng/

# The Bootlin base toolchain, when vendored inside the project:
# 0.0_BUILD_TOOLCHAIN.sh downloads it SHA-256-verified when absent.
/tools/

# Phoenix's local build sandbox (sibling inputs wired by symlink).
/build-area/

# Release zips are GitHub release assets, not repo content.
/*.zip
